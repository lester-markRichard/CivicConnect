<%- include("partials/_header", { activePage: 'reports' }) %>

<main class="reports-container">
  <h1>Reports Dashboard</h1>
  <p class="subtitle">View all submissions and report summaries below.</p>

  <div class="reports-controls">
    <input type="text" id="searchReport" placeholder="🔍 Search by ID or User" />
    <select id="filterStatus">
      <option value="">All Status</option>
      <option value="pending">Pending</option>
      <option value="reviewed">Reviewed</option>
      <option value="resolved">Resolved</option>
    </select>
  </div>

  <section class="report-list">
    <% if (reports && reports.length > 0) { %>
      <% reports.forEach(report => { %>
        <div class="report-card <%= report.status || 'pending' %>">
          <h3><%= report.title %></h3>
          <p><strong>Location:</strong> <%= report.location %></p>
          <p><strong>Date:</strong> <%= report.createdAt.toDateString() %></p>
          <% if (report.imageUrl) { %>
            <img src="<%= report.imageUrl %>" alt="Report Image" class="report-img">
          <% } %>
          <span class="status-badge <%= report.status || 'pending' %>">
            <%= (report.status || 'Pending').charAt(0).toUpperCase() + (report.status || 'Pending').slice(1) %>
          </span>
        </div>
      <% }); %>
    <% } else { %>
      <p class="no-data">No reports found.</p>
    <% } %>
  </section>
</main>

<%- include("partials/_footer") %>
