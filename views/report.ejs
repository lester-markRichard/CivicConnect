<%- include("partials/_header", { activePage: 'report' }) %>

<main class="report-container">
  <h2>Report an Issue</h2>
  <p class="report-intro">Help us make our community better by reporting issues you notice in your area.</p>

  <form action="/api/reports/add" method="POST" enctype="multipart/form-data" class="report-form">

    <div class="form-group">
      <label for="title">Issue Title</label>
      <input type="text" id="title" name="title" placeholder="e.g. Pothole near Main Street" required>
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="5" placeholder="Describe the issue in detail..." required></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input type="text" id="location" name="location" placeholder="Enter the exact location" required>
    </div>

    <div class="form-group">
      <label for="image">Upload Image (optional)</label>
      <input type="file" id="image" name="image" accept="image/*">
    </div>

    <button type="submit" class="btn">Submit Report</button>
  </form>
</main>

<%- include("partials/_footer") %>
