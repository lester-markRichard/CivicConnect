<%- include("partials/_header", { activePage: 'about' }) %>

<main class="about-container">
  <!-- Hero Section -->
  <section class="about-hero">
    <h1>About CivicConnect</h1>
    <p>Empowering citizens to take action and make their neighborhoods better, cleaner, and safer.</p>
  </section>

  <!-- Mission Section -->
  <section class="about-mission">
    <h2>Our Mission</h2>
    <p>
      Reveal It is built to bridge the gap between citizens and civic authorities.
      By reporting issues in real-time, you help bring transparency and accountability to local governance.
    </p>
  </section>

  <!-- How It Works -->
  <section class="about-steps">
    <h2>How It Works</h2>
    <div class="steps-grid">
      <div class="step-card">
        <h3>1️⃣ Report</h3>
        <p>Spot a civic problem? Capture it with a photo and submit a short report in seconds.</p>
      </div>
      <div class="step-card">
        <h3>2️⃣ Review</h3>
        <p>Authorities review and verify submitted reports for authenticity and prioritization.</p>
      </div>
      <div class="step-card">
        <h3>3️⃣ Resolve</h3>
        <p>Once verified, action is taken to resolve the issue and update the status to ‘Resolved’.</p>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="about-team">
    <h2>Meet the Team</h2>
    <div class="team-grid">
      <div class="team-member">
        <img src="/images/team1.jpg" alt="Manish Panchal" />
        <h3>Manish Panchal</h3>
        <p>Roll No: 22<br>Team Member</p>
      </div>
      <div class="team-member">
        <img src="/images/team2.jpg" alt="Om Pandey" />
        <h3>Om Pandey</h3>
        <p>Roll No: 23<br>Team Member</p>
      </div>
      <div class="team-member">
        <img src="/images/team3.jpg" alt="Lester Mark Richard" />
        <h3>Lester Mark Richard</h3>
        <p>Roll No: 32<br>Team Member</p>
      </div>
      <div class="team-member">
        <img src="/images/team4.jpg" alt="Samrel Joe" />
        <h3>Samrel Joe</h3>
        <p>Roll No: 37<br>Team Member</p>
      </div>
    </div>
  </section>
</main>

<%- include("partials/_footer") %>
